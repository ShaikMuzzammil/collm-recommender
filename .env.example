# ─── Database (Required) ──────────────────────────────────────────────────────
# Get from: Vercel Dashboard → Storage → Create Database → Postgres
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# ─── NextAuth (Required) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Your Vercel deployment URL
NEXTAUTH_URL="https://collm-recommender.vercel.app"

# ─── Email: Gmail SMTP (Option 2 — Free, No Domain Needed) ───────────────────
# Create a dedicated Gmail account: collm.mail@gmail.com
# Enable 2-Step Verification in Google Account → Security
# Create App Password at: https://myaccount.google.com/apppasswords
#   App Name: CoLLM Platform
#   Copy the 16-character password (remove spaces)
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# ─── Google OAuth (Optional) ─────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Resend (Option 1 — Requires Verified Domain) ────────────────────────────
# Only use if you have a verified domain at resend.com
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM_EMAIL="CoLLM Platform <reports@yourdomain.com>"
