# ============================================================
# CoLLM Platform — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ── DATABASE (Neon PostgreSQL — free tier) ─────────────────
# Get your connection string from: https://neon.tech
# Create project → copy "Connection String" (pooled)
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/collm?sslmode=require"

# Neon "Direct Connection" (non-pooled, for migrations)
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/collm?sslmode=require"

# ── NEXTAUTH.JS ──────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://your-app.vercel.app"

# ── GOOGLE OAUTH (optional) ──────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── RESEND EMAIL (free 3,000 emails/month) ───────────────────
# Get API key from: https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# The "from" address (must be verified domain or use resend.dev in test)
RESEND_FROM_EMAIL="CoLLM Platform <reports@yourdomain.com>"
# For testing use: "CoLLM Platform <onboarding@resend.dev>"

# ── OPTIONAL SERVICES ─────────────────────────────────────────
# Upstash Redis — for job queuing (free tier)
# https://upstash.com
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# ── APP CONFIG ─────────────────────────────────────────────────
NODE_ENV="development"
