# ─────────────────────────────────────────────────────────────────
#  CoLLM — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────
PORT=8000
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
MODEL_SAVE_PATH=./models/collm
LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────
# Local dev → http://localhost:8000
# Docker    → http://backend:8000
# Render    → https://your-backend.onrender.com
REACT_APP_API_URL=http://localhost:8000

# ── GitHub Actions secrets (set in repo Settings → Secrets) ──────
# RENDER_DEPLOY_HOOK_BACKEND=https://api.render.com/deploy/srv-xxx?key=yyy
# RENDER_DEPLOY_HOOK_FRONTEND=https://api.render.com/deploy/srv-xxx?key=yyy
# BACKEND_URL=https://collm-backend.onrender.com
# DEPLOY_URL=https://collm-frontend.onrender.com

# ── Data ─────────────────────────────────────────────────────────
ML1M_PATH=data/ml-1m/ratings.dat
AMAZON_PATH=data/amazon-book/Books.json.gz
PROCESSED_DIR=data/processed
