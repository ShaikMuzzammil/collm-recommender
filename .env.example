# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="https://collm-recommender.vercel.app"

# ─── Google OAuth (for Sign In with Google) ──────────────────────────────────
# 1. Go to: console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URIs:
#    https://collm-recommender.vercel.app/api/auth/callback/google
#    http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ─── Email: Resend (contact form) ───────────────────────────────────────────
# Sign up free at resend.com — use onboarding@resend.dev until domain verified
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="CoLLM Platform <onboarding@resend.dev>"
# Email for receiving contact form submissions (defaults to EMAIL_USER if not set)
CONTACT_ADMIN_EMAIL="your@email.com"

# ─── Email: Gmail SMTP (report delivery) ────────────────────────────────────
# 1. Create Gmail account: collm.platform@gmail.com
# 2. Enable 2-Step Verification in Google Account → Security
# 3. Go to: myaccount.google.com/apppasswords → Create "CoLLM Platform"
# 4. Copy the 16-char password (remove spaces)
EMAIL_USER="collm.platform@gmail.com"
EMAIL_PASS="abcdefghijklmnop"
