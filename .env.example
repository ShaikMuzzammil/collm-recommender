# ============================================================
# CoLLM Platform — Environment Variables
# Copy this file to .env (never commit .env to git)
# ============================================================

# ── DATABASE — Neon PostgreSQL (free tier: neon.tech) ────────
# In Neon dashboard: Project → Connection Details
# Use "Connection string" — toggle "Pooled connection" ON for DATABASE_URL
DATABASE_URL="postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/collm?sslmode=require&pgbouncer=true&connect_timeout=15"

# Non-pooled (direct) connection for migrations/prisma db push
DIRECT_URL="postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/collm?sslmode=require&connect_timeout=15"

# ── NEXTAUTH ─────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-plus-char-random-secret"

# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Vercel production (set in Vercel dashboard, not here):
# NEXTAUTH_URL="https://your-app.vercel.app"

# ── GOOGLE OAUTH (optional — leave blank to disable) ─────────
# console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── RESEND EMAIL (optional — free 3,000 emails/month) ────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Must be a verified sender domain (or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="CoLLM Platform <onboarding@resend.dev>"

# ── NODE ENV ─────────────────────────────────────────────────
NODE_ENV="development"
